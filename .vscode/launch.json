{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: Run Test Script",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/eds/cfecfs/testrunner/examples/runtest.py",
            "console": "integratedTerminal",
            "args": ["${fileBasenameNoExtension}"]
        },
        {
            "name": "CPython: Current File",
            "type": "cppdbg",
            "request": "launch",
            "program": "/usr/bin/python3",
            "args": ["${file}"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "PYTHONPATH",
                    "value": "${workspaceFolder}/tools/cfs-cosmos-plugin/lib:${workspaceFolder}/tools/cfs-cosmos-plugin/targets/CFS/procedures:${workspaceFolder}/tools/astro:${workspaceFolder}/build-native_jeds/exe/lib/python"
                },
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "${workspaceFolder}/build-native_jeds/exe/lib"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "(gdb) Launch Native CFE Core 1",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-native_std/exe/cpu1/core-cpu1",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build-native_std/exe/cpu1",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "(gdb) Launch EDS CFE Core 1",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-native_jeds/exe/cpu1/core-cpu1",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build-native_jeds/exe/cpu1",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "(gdb) Launch EDS CFE Core 2",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-native_jeds/exe/cpu2/core-cpu2",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build-native_jeds/exe/cpu2",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "(gdb) Launch OSAL Functional Test",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-native_jeds/exe/cpu1/osal-core-test",
            "args": ["-v"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build-native_jeds/exe/cpu1",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "(gdb) Launch CFE Unit Test (native)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-native_jstd/exe/cpu1/coverage-msg-ALL-testrunner",
            //"program": "${workspaceFolder}/build-native_jstd/exe/cpu1/osal-core-test",
            "args": ["-d"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build-native_jstd/exe/cpu1",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "(gdb) Launch CFE Unit Test (eds)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-native_jeds/exe/cpu1/coverage-tbl-ALL-testrunner",
            "args": ["-d"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build-native_jeds/exe/cpu1",
            "environment": [
                {
                    "name":"ASAN_OPTIONS",
                    "value":"abort_on_error=1"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "(gdb) Run EDS generator tool",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-native_jeds/tools/eds/tool/sedstool",
            "environment": [{
                "name": "VERBOSE",
                "value": "2"
            }],
            "args": [
                 "-DMAKE_PROGRAM=/usr/bin/gmake",
                 "-DCFLAGS="
                 "-DCC=/usr/bin/cc",
                 "-DAR=/usr/bin/ar",
                 "-DOBJDIR=obj"
                 "-DEDSTOOL_OUTPUT_DIR=${workspaceFolder}/build-native_jeds",
                 "-DEDSTOOL_PROJECT_NAME=SampleMission",
                 "${workspaceFolder}/sample_defs/eds/cfe-topicids.xml",
                 "${workspaceFolder}/sample_defs/eds/config.xml",
                 "${workspaceFolder}/cfe/modules/core_api/eds/base_types.xml"
                 //"${workspaceFolder}/apps/ci_lab/eds/ci_lab.xml",
                 //"${workspaceFolder}/apps/to_lab/eds/to_lab.xml",
                 //"${workspaceFolder}/apps/sch_lab/eds/sch_lab.xml",
                 //"${workspaceFolder}/apps/soistest/eds/ccsds_sois_presentwhen.xml",
                 //"${workspaceFolder}/apps/soistest/eds/ccsds_sois_sampletypes.xml",
                 "${workspaceFolder}/apps/sample_app/eds/sample_app.xml",
                 //"${workspaceFolder}/apps/fcgiapp/eds/fcgi.xml",
                 //"${workspaceFolder}/apps/fm/eds/fm.xml",
                 //"${workspaceFolder}/apps/hk/eds/HK.xml",
                 //"${workspaceFolder}/apps/ds/eds/DS.xml",
                 //"${workspaceFolder}/apps/hs/eds/HS.xml",
                 "${workspaceFolder}/tools/eds/cfecfs/missionlib/eds/instance-rules.xml",
                 "${workspaceFolder}/cfe/modules/es/eds/cfe_es.xml",
                 "${workspaceFolder}/cfe/modules/evs/eds/cfe_evs.xml",
                 "${workspaceFolder}/cfe/modules/fs/eds/cfe_fs.xml",
                 "${workspaceFolder}/cfe/modules/sb/eds/cfe_sb.xml",
                 "${workspaceFolder}/cfe/modules/tbl/eds/cfe_tbl.xml",
                 "${workspaceFolder}/cfe/modules/time/eds/cfe_time.xml",
                 "${workspaceFolder}/tools/eds/cfecfs/edsmsg/eds/ccsds_spacepacket.xml",
                 "${workspaceFolder}/tools/eds/cfecfs/edsmsg/eds/cfe_hdr.xml",
                 "${workspaceFolder}/cfe/modules/resourceid/eds/cfe_resourceid.xml",
                 "${workspaceFolder}/tools/eds/tool/scripts/05-seds_parse_defines.lua",
                 "${workspaceFolder}/tools/eds/tool/scripts/10-seds_resolve_refs.lua",
                 "${workspaceFolder}/tools/eds/tool/scripts/15-seds_create_implicit_scalars.lua",
                 "${workspaceFolder}/tools/eds/tool/scripts/20-seds_resolve_sizes.lua",
                 "${workspaceFolder}/tools/eds/tool/scripts/25-seds_resolve_constraints.lua",
                 "${workspaceFolder}/tools/eds/tool/scripts/30-seds_resolve_components.lua",
                 "${workspaceFolder}/tools/eds/edslib/eds/40-seds_write_headers.lua",
                 "${workspaceFolder}/tools/eds/edslib/eds/45-seds_write_datatypedb_objects.lua",
                 "${workspaceFolder}/tools/eds/edslib/eds/50-seds_write_displaydb_objects.lua",
                 "${workspaceFolder}/tools/eds/edslib/eds/52-seds_write_intfdb_objects.lua",
                 "${workspaceFolder}/tools/eds/edslib/eds/55-write_edsdb_makefiles.lua",
                 "${workspaceFolder}/tools/eds/edslib/eds/59-load_edsdb.lua",
                 "${workspaceFolder}/tools/eds/cfecfs/missionlib/eds/70-cfe_sb_parameter_map.lua",
                 "${workspaceFolder}/tools/eds/cfecfs/missionlib/eds/75-cfe_sb_dispatch_tables.lua",
                 "${workspaceFolder}/tools/eds/cfecfs/missionlib/eds/70-cfe_sb_parameter_map.lua",
                 "${workspaceFolder}/tools/eds/cfecfs/missionlib/eds/74-cfe_sb_msg_topic_ids.lua",
                 "${workspaceFolder}/tools/eds/cfecfs/missionlib/eds/75-cfe_sb_dispatch_tables.lua",
                 "${workspaceFolder}/tools/eds/cfecfs/missionlib/eds/76-cfe_sb_topicdb_global.lua",
                 "${workspaceFolder}/tools/eds/cfecfs/missionlib/eds/78-cfe_sb_global.lua",
                 "${workspaceFolder}/tools/eds/cfecfs/missionlib/eds/80-build_cfe_sb_interfacedb.lua",
                 //"${workspaceFolder}/tools/eds/cfecfs/missionlib/eds/85-write_commandcode_headers.lua",
                 //"${workspaceFolder}/tools/eds/cfecfs/missionlib/eds/86-write_dds_idl.lua",
                 //"${workspaceFolder}/tools/eds/cfecfs/missionlib/eds/90-write_ccdd_json.lua",
                 //"${workspaceFolder}/tools/eds/cfecfs/missionlib/eds/90-write_intf_hierarchy.lua",
                 //"${workspaceFolder}/tools/eds/cfecfs/missionlib/eds/91-write_cosmos_txt.lua",
                 "${workspaceFolder}/tools/eds/cfecfs/missionlib/eds/95-write_crosscheck_tests.lua",
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build-native_jeds",
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "(gdb) Run EDS Table Tool",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-native_jeds/tools/eds/cfecfs/eds2cfetbl/eds2cfetbl",
            "environment": [{
                "name": "VERBOSE",
                "value": "2"
            }],
            "args": [
                 //"${workspaceFolder}/apps/soistest/ccsds.sois/seds/interoperability/reference/scripts/nasacfs_generate_bin.lua",
                 //"${workspaceFolder}/apps/soistest/ccsds.sois/seds/interoperability/reference/scripts/nasacfs_generate_bin.lua",
                 "-e", "MISSION_DEFS=\\\"${workspaceFolder}/joe_defs\\\"",
                 "-e", "CPUNAME=\\\"cpu1\\\"",
                 "-e", "APPNAME=\\\"ci\\\"",
                 "-e", "TABLENAME=\\\"ci_tcpcfg_tbl\\\"",
                 "${workspaceFolder}/build-native_jeds/tables/eds/cpu1/ci_ci_udpcfg_tbl.so"
                 //"${workspaceFolder}/build-native_jeds/tables/eds/cpu1/ci_ci_tcpcfg_tbl.so"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build-native_jeds",
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
